# Terasic C5G User Manual:
# https://solitonwave.co.jp/shop_pro/download/fpga/terasic/c5g/C5G_User_Manual_v7.pdf
# Table 3-6: CLOCK_50_B5B, 50 MHz, PIN_R20, 3.3 V.
# Table 3-4: LEDG0, PIN_L7, 2.5 V; high level turns LED on.

set_location_assignment PIN_R20 -to clk
set_location_assignment PIN_L7 -to led
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_instance_assignment -name IO_STANDARD "2.5 V" -to led

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CGXFC5C6F27C7
set_global_assignment -name TOP_LEVEL_ENTITY blink
set_global_assignment -name VERILOG_FILE ../hdl/blink.v
set_global_assignment -name SDC_FILE blink.sdc
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY ../build/blink
set_global_assignment -name LAST_QUARTUS_VERSION "23.1std.0 Lite Edition"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"