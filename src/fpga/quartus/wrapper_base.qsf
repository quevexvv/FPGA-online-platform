# Trusted C5G wrapper: LED mapping matches the verified LED test.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CGXFC5C6F27C7
set_global_assignment -name TOP_LEVEL_ENTITY fpga_wrapper
set_global_assignment -name VERILOG_FILE ../hdl/fpga_wrapper.v
set_global_assignment -name VERILOG_FILE ../hdl/dut_control.v
set_global_assignment -name VERILOG_FILE ../hdl/clock_burst.v
set_global_assignment -name VERILOG_FILE ../hdl/uart_service.v
set_global_assignment -name VERILOG_FILE ../hdl/uart_commands.v
set_global_assignment -name VERILOG_FILE ../hdl/uart_rx.v
set_global_assignment -name VERILOG_FILE ../hdl/uart_tx.v
set_global_assignment -name SDC_FILE wrapper.sdc
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to control|generator|dut_clk
set_location_assignment PIN_R20 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_instance_assignment -name IO_STANDARD "2.5 V" -to led[*]
set_location_assignment PIN_F7 -to led[0]
set_location_assignment PIN_F6 -to led[1]
set_location_assignment PIN_G6 -to led[2]
set_location_assignment PIN_G7 -to led[3]
set_location_assignment PIN_J8 -to led[4]
set_location_assignment PIN_J7 -to led[5]
set_location_assignment PIN_K10 -to led[6]
set_location_assignment PIN_K8 -to led[7]
set_location_assignment PIN_H7 -to led[8]
set_location_assignment PIN_J10 -to led[9]
set_location_assignment PIN_L7 -to led[10]
set_location_assignment PIN_K6 -to led[11]
set_location_assignment PIN_D8 -to led[12]
set_location_assignment PIN_E9 -to led[13]
set_location_assignment PIN_A5 -to led[14]
set_location_assignment PIN_B6 -to led[15]
set_location_assignment PIN_H8 -to led[16]
set_location_assignment PIN_H9 -to led[17]
# C5G manual, Table 3-8: FPGA TX=L9, FPGA RX=M9, 2.5 V.
set_location_assignment PIN_L9 -to tx
set_location_assignment PIN_M9 -to rx
set_instance_assignment -name IO_STANDARD "2.5 V" -to tx
set_instance_assignment -name IO_STANDARD "2.5 V" -to rx
