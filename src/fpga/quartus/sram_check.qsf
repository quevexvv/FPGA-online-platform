set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CGXFC5C6F27C7
set_global_assignment -name TOP_LEVEL_ENTITY sram_check
set_global_assignment -name VERILOG_FILE ../hdl/sram_check.v
set_global_assignment -name VERILOG_FILE ../hdl/c5g_sram_word.v
set_global_assignment -name VERILOG_FILE ../hdl/jtag_snapshot.v
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY ../build/sram-check
set_global_assignment -name SDC_FILE c5g-sram.sdc
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE OFF
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_location_assignment PIN_R20 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
source c5g-sram.qsf

set_global_assignment -name LAST_QUARTUS_VERSION "23.1std.0 Lite Edition"
