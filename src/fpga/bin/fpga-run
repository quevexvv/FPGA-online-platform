#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 1 && $1 == --help ]]; then
    cat <<'HELP'
Usage: fpga-run --help
Планируемый внутренний интерфейс:
  fpga-run --job <path> --output <path> --mode hardware|mock

Каркас: исполнитель ещё не реализован.
Бэкенд должен вызывать fpga-dispatch, а не fpga-run.
HELP
    exit 0
fi

printf '%s\n' 'fpga-run: исполнитель ещё не реализован; см. --help.' >&2
exit 2
