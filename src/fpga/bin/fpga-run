#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 1 && $1 == --help ]]; then
    cat <<'HELP'
Usage: fpga-run --help
Внутренний интерфейс:
  fpga-run --job <input> --output <output> --mode hardware|mock

Бэкенд должен вызывать fpga-dispatch, а не fpga-run.
HELP
    exit 0
fi

fail() {
    printf 'fpga-run: %s\n' "$2" >&2
    exit "$1"
}

safe_dir() { [[ -d $1 && ! -L $1 ]]; }
safe_file() { [[ -f $1 && ! -L $1 ]]; }

[[ $# -eq 6 && $1 == --job && $3 == --output && $5 == --mode &&
    ( $6 == hardware || $6 == mock ) ]] || fail 2 'expected --job, --output and --mode'
mode=$6
id=${2%/input}
id=${id##*/}
[[ $id =~ ^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$ ]] || fail 2 'invalid run_id'
[[ -n ${FPGA_JOBS_ROOT:-} && $FPGA_JOBS_ROOT == /* && -d $FPGA_JOBS_ROOT ]] ||
    fail 1 'FPGA_JOBS_ROOT must be an existing absolute directory'
root=$(cd -- "$FPGA_JOBS_ROOT" && pwd -P)
[[ $root != / ]] || fail 1 'FPGA_JOBS_ROOT must be dedicated to jobs'
umask 077
runs=$root/runs
run=$runs/$id
output=$run/output
control=$run/control
work=$run/work
id_lock_path=$runs/.locks/$id
[[ $2 == "$run/input" && $4 == "$output" ]] || fail 2 'paths must belong to the registered run'
for directory in "$runs" "$runs/.locks" "$run" "$run/input" "$work" "$output" "$output/logs" "$control"; do
    safe_dir "$directory" || fail 2 'run directories are missing or unsafe'
done
safe_file "$id_lock_path" || fail 2 'run_id is not registered'
exec {id_lock}>> "$id_lock_path"
flock -x "$id_lock"

if ! safe_file "$control/registration.json" || ! safe_file "$output/status.json"; then
    fail 2 'registration is missing or unsafe'
fi
jq -es --arg id "$id" --arg mode "$mode" '
    . == [{schema_version:1,run_id:$id,mode:$mode}]
' "$control/registration.json" >/dev/null || fail 2 'registration does not match run_id and mode'
jq -es --arg id "$id" --arg mode "$mode" '
    length == 1 and (.[0] | .schema_version == 1 and .run_id == $id and .mode == $mode and
                     .state == "starting" and .stage == "dispatch")
' "$output/status.json" >/dev/null || fail 2 'run is not waiting to start'
[[ ! -e $output/result.json && ! -L $output/result.json ]] || fail 2 'run already has a result'
mkdir -- "$control/started" 2>/dev/null || fail 2 'run cannot be started again'
# Release the ID lock so status can be read while the stand is busy.
exec {id_lock}>&-

timestamp() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }

write_json() {
    local destination=$1 temporary
    shift
    temporary=$(mktemp -- "$output/.json.XXXXXXXX")
    if ! jq -cn "$@" > "$temporary" || ! mv -T -- "$temporary" "$destination"; then
        rm -f -- "$temporary"
        fail 1 'cannot publish run JSON'
    fi
}

started_at=
finish_run() {
    local result=$1 stage=$2 code=$3 message=$4 now log logs
    local log_files=()
    now=$(timestamp)
    for log in logs/{build,program,uart,test}.log; do
        if safe_file "$output/$log"; then log_files+=("$log"); fi
    done
    logs=$(jq -cn --args '$ARGS.positional' "${log_files[@]}")
    # shellcheck disable=SC2016
    write_json "$output/result.json" --arg id "$id" --arg mode "$mode" --arg result "$result" \
        --arg started "$started_at" --arg now "$now" --arg stage "$stage" --arg code "$code" \
        --arg message "$message" --argjson logs "$logs" '
        {schema_version:1,run_id:$id,mode:$mode,status:$result,hardware_verified:false,
         started_at:($started | select(length>0) // null),finished_at:$now,
         summary:{planned:0,executed:0,passed:0,failed:0},observations:[],
         error:{stage:$stage,code:$code,message:$message},logs:$logs}'
    # shellcheck disable=SC2016
    write_json "$output/status.json" --arg id "$id" --arg mode "$mode" --arg result "$result" \
        --arg started "$started_at" --arg now "$now" '
        {schema_version:1,run_id:$id,mode:$mode,state:"finished",stage:"finalizing",
         started_at:($started | select(length>0) // null),updated_at:$now,finished_at:$now,
         result_status:$result}'
    exit 0
}

stand_lock_path=$runs/.stand.lock
if [[ -L $stand_lock_path || ( -e $stand_lock_path && ! -f $stand_lock_path ) ]]; then
    finish_run internal_error locking stand_lock_error 'Stand lock path is unsafe'
fi
exec {stand_lock}>> "$stand_lock_path"
lock_result=0
flock -n -E 75 "$stand_lock" || lock_result=$?
case "$lock_result" in
    0) ;;
    75) finish_run busy locking stand_busy 'Stand is already in use' ;;
    *) finish_run internal_error locking stand_lock_error 'Cannot lock the stand' ;;
esac

if [[ $mode == mock ]]; then
    finish_run internal_error validating mock_unavailable 'Mock execution is not available yet'
fi

config=${FPGA_RUN_CONFIG:-}
if [[ $config != /* ]] || ! safe_file "$config"; then
    finish_run internal_error validating config_invalid 'Set FPGA_RUN_CONFIG to the stand configuration'
fi
settings=$(jq -ers '
    def limit: type == "number" and . == floor and . >= 1 and . <= 2147483647;
    def text: type == "string" and length > 0 and (test("[[:cntrl:]]") | not);
    def path: text and startswith("/");
    select(length == 1) | .[0] |
    select((.quartus_sh | path) and (.quartus_pgm | path) and (.uart_device | path) and
           (.jtag_cable | text) and (.jtag_device_index | limit) and
           (.build_timeout_ms | limit) and (.max_log_bytes | limit) and
           (.program_timeout_ms | limit) and (.uart_ready_timeout_ms | limit) and (.test_timeout_ms | limit) and
           (.uart_timeout_ms | limit and . <= 60000)) |
    .quartus_sh, .quartus_pgm, .jtag_cable, .jtag_device_index, .uart_device,
    .build_timeout_ms, .program_timeout_ms, .uart_ready_timeout_ms, .uart_timeout_ms, .test_timeout_ms, .max_log_bytes
' "$config") || finish_run internal_error validating config_invalid 'Stand tools or stage limits are invalid'
{
    IFS= read -r quartus
    IFS= read -r programmer
    IFS= read -r cable
    IFS= read -r device_index
    IFS= read -r uart_device
    IFS= read -r build_timeout
    IFS= read -r program_timeout
    IFS= read -r uart_ready_timeout
    IFS= read -r uart_timeout
    IFS= read -r test_timeout
    IFS= read -r max_log
} <<< "$settings"
for tool in "$quartus" "$programmer"; do
    [[ -f $tool && -x $tool ]] ||
        finish_run internal_error validating config_invalid 'Configured Quartus executable is missing'
done
project=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
[[ -x $project/build/fpga-stage && -x $project/build/fpga-uart ]] ||
    finish_run internal_error validating stage_missing 'Build the host tools with make all'

vectors=$work/test-set.json
if ! safe_file "$vectors" || ! jq -es -f "$project/scripts/test-set.jq" "$vectors" >/dev/null; then
    finish_run internal_error validating test_set_invalid 'Prepared test set is missing or invalid'
fi
plan=$(jq -r '.[] | [.reset_before, .din, .steps] | @tsv' "$vectors")
commands=$work/uart-commands
(
    set -o noclobber
    while IFS=$'\t' read -r reset din steps; do
        if [[ $reset == true ]]; then printf '%s\n' reset; fi
        printf 'input 0%s\nstep %04x\nread\n' "${din#0x}" "$steps"
    done <<< "$plan" > "$commands"
) || finish_run internal_error validating test_plan_failed 'Cannot prepare UART commands'

quartus_dir=$work/quartus
artifacts=$quartus_dir/output_files
safe_dir "$quartus_dir" || finish_run internal_error building project_missing 'Prepared project is missing'
for file in job.qpf job.qsf wrapper_base.qsf wrapper.sdc; do
    safe_file "$quartus_dir/$file" ||
        finish_run internal_error building project_missing 'Prepared project is missing'
done
if [[ -e $artifacts || -L $artifacts ]]; then
    finish_run build_error building output_exists 'Quartus output directory already exists'
fi
mkdir -- "$work/home" "$work/tmp" ||
    finish_run internal_error building workspace_error 'Cannot create private Quartus directories'

publish_stage() {
    local stage=$1
    # shellcheck disable=SC2016
    write_json "$output/status.json" --arg id "$id" --arg mode "$mode" --arg started "$started_at" \
        --arg stage "$stage" --arg now "$(timestamp)" '
        {schema_version:1,run_id:$id,mode:$mode,state:"running",stage:$stage,
         started_at:$started,updated_at:$now,finished_at:null,result_status:null}'
}

run_stage() {
    local timeout=$1 log=$2 stage_pid
    shift 2
    interrupted=false
    trap 'interrupted=true' HUP INT TERM
    (
        cd -- "$quartus_dir" || exit 125
        exec env -i PATH=/usr/bin:/bin LC_ALL=C HOME="$work/home" TMPDIR="$work/tmp" \
            "$project/build/fpga-stage" "$timeout" "$max_log" "$output/$log" -- "$@"
    ) &
    stage_pid=$!
    stage_result=0
    if [[ $interrupted == false ]]; then
        wait "$stage_pid" || stage_result=$?
    fi
    if [[ $interrupted == true ]]; then
        trap '' HUP INT TERM
        kill -TERM "$stage_pid" 2>/dev/null || :
        wait "$stage_pid" || :
        stage_result=143
    fi
    trap - HUP INT TERM
}

started_at=$(timestamp)
publish_stage building
run_stage "$build_timeout" logs/build.log "$quartus" --flow compile job
case "$stage_result" in
    0) ;;
    124) finish_run build_error building build_timeout 'Quartus build timed out' ;;
    1) finish_run build_error building quartus_failed 'Quartus build failed' ;;
    129|130|143) finish_run internal_error building interrupted 'Build was interrupted' ;;
    *) finish_run internal_error building stage_failed 'Could not run Quartus build' ;;
esac
sof=$artifacts/job.sof
if ! safe_dir "$artifacts" || ! safe_file "$sof" || [[ ! -s $sof || $(stat -c %h -- "$sof") != 1 ]]; then
    finish_run build_error building missing_sof 'Quartus did not create a new job.sof'
fi
publish_stage programming
run_stage "$program_timeout" logs/program.log "$programmer" -c "$cable" -m JTAG \
    -o "p;output_files/job.sof@$device_index"
case "$stage_result" in
    0) ;;
    124) finish_run board_error programming program_timeout 'Programming timed out' ;;
    1) finish_run board_error programming program_failed 'Quartus could not program the board' ;;
    129|130|143) finish_run internal_error programming interrupted 'Programming was interrupted' ;;
    *) finish_run internal_error programming stage_failed 'Could not run the programmer' ;;
esac
run_stage "$uart_ready_timeout" logs/uart.log bash "$project/scripts/uart-job.sh" \
    "$project/build/fpga-uart" "$uart_device" "$uart_timeout" probe
case "$stage_result" in
    0) ;;
    1|124) finish_run board_error programming uart_not_ready 'UART readiness check failed' ;;
    129|130|143) finish_run internal_error programming interrupted 'UART readiness check was interrupted' ;;
    *) finish_run internal_error programming stage_failed 'Could not run the UART readiness check' ;;
esac
publish_stage testing
replies=$work/uart-replies
run_stage "$test_timeout" logs/test.log bash "$project/scripts/uart-job.sh" \
    "$project/build/fpga-uart" "$uart_device" "$uart_timeout" vectors "$commands" "$replies"
report=$work/observations.json
if ! safe_file "$replies"; then replies=/dev/null; fi
jq -cn --slurpfile vectors "$vectors" --rawfile replies "$replies" \
    -f "$project/scripts/observations.jq" > "$report"
case "$stage_result" in
    0) jq -e '.complete' "$report" >/dev/null ||
           finish_run board_error testing incomplete_observations 'UART did not return all observations' ;;
    1|124) finish_run board_error testing uart_test_failed 'UART test ended before all vectors completed' ;;
    129|130|143) finish_run internal_error testing interrupted 'UART testing was interrupted' ;;
    *) finish_run internal_error testing stage_failed 'Could not run the UART test' ;;
esac
finish_run internal_error finalizing comparison_unavailable 'Observations are ready; comparison is not available yet'
