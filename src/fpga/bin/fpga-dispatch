#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 1 && $1 == --help ]]; then
    cat <<'HELP'
Usage: fpga-dispatch submit --run-id <uuid> --mode hardware|mock
  fpga-dispatch status --run-id <uuid>
  fpga-dispatch cleanup --run-id <uuid>

FPGA_JOBS_ROOT задаёт корень incoming и runs.
Submit регистрирует задания и запускает пользовательский сервис systemd.
FPGA_DISPATCH_LAUNCH=manual оставляет запуск оператору.
Cleanup удаляет данные завершённого задания после их сохранения бэкендом.
HELP
    exit 0
fi

fail() {
    printf 'fpga-dispatch: %s\n' "$2" >&2
    exit "$1"
}

operation=${1:-}
run_id=${3:-}
mode=${5:-}
case "$operation" in
    submit)
        [[ $# -eq 5 && $4 == --mode && ( $mode == hardware || $mode == mock ) ]] ||
            fail 2 'expected submit --run-id <uuid> --mode hardware|mock'
        launch=${FPGA_DISPATCH_LAUNCH:-systemd}
        [[ $launch == systemd || $launch == manual ]] ||
            fail 1 'FPGA_DISPATCH_LAUNCH must be systemd or manual'
        ;;
    status|cleanup) [[ $# -eq 3 ]] || fail 2 "expected $operation --run-id <uuid>" ;;
    *) fail 2 'unknown command; see --help' ;;
esac
[[ ${2:-} == --run-id && $run_id =~ ^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$ ]] ||
    fail 2 'expected a lowercase UUID'

[[ -n ${FPGA_JOBS_ROOT:-} && $FPGA_JOBS_ROOT == /* && -d $FPGA_JOBS_ROOT ]] ||
    fail 1 'FPGA_JOBS_ROOT must be an existing absolute directory'
root=$(cd -- "$FPGA_JOBS_ROOT" && pwd -P)
[[ $root != / ]] || fail 1 'FPGA_JOBS_ROOT must be dedicated to jobs'
umask 077
project=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
# shellcheck source=scripts/run-state.sh
source "$project/scripts/run-state.sh"
# shellcheck source=scripts/reconcile-run.sh
source "$project/scripts/reconcile-run.sh"
incoming=$root/incoming
runs=$root/runs
locks=$runs/.locks
[[ -d $incoming && ! -L $incoming && ! -L $runs ]] || fail 1 'unsafe job directories'
mkdir -p -- "$runs"
[[ ! -L $locks ]] || fail 1 'unsafe lock directory'
mkdir -p -- "$locks"
[[ ! -L $locks/$run_id && ( ! -e $locks/$run_id || -f $locks/$run_id ) ]] ||
    fail 1 'unsafe lock file'
exec {lock_fd}>> "$locks/$run_id"
flock -x "$lock_fd"

upload=$incoming/$run_id
run=$runs/$run_id
pending=$runs/.$run_id.pending
ready=$pending/ready
control=$run/control
output=$run/output
cleaned=$control/cleaned.json
registered=false
if exists "$run"; then
    if ! safe_dir "$run" || ! safe_dir "$control"; then
        fail 1 'unsafe run directories'
    fi
    if exists "$cleaned"; then
        safe_file "$cleaned" || fail 1 'unsafe cleanup marker'
        jq -es --arg id "$run_id" '
            . == [{schema_version:1,run_id:$id,state:"cleaned"}]
        ' "$cleaned" >/dev/null || fail 1 'invalid cleanup marker'
    else
        if ! safe_dir "$output" || ! safe_file "$control/registration.json" ||
            ! safe_file "$output/status.json"; then
            fail 1 'registration is incomplete or unsafe'
        fi
        registered_mode=$(jq -ers --arg id "$run_id" '
            select(length == 1) | .[0] |
            select(.schema_version == 1 and .run_id == $id and (.mode == "hardware" or .mode == "mock")) | .mode
        ' "$control/registration.json") || fail 1 'registration is invalid'
    fi
    registered=true
fi

# Recover an interrupted submit under the same lock. A published directory
# is authoritative. Before publication the original upload can be restored.
recover_pending() {
    if ! exists "$pending"; then return 0; fi
    [[ -d $pending && ! -L $pending && ! -L $ready && ! -L $ready/input ]] || return 1
    if [[ ! -d $run || -L $run ]] && exists "$pending/upload"; then
        if exists "$upload"; then return 1; fi
        mv -T -- "$pending/upload" "$upload" || return 1
    fi
    if [[ -d $ready/input ]]; then chmod -R u+w -- "$ready/input" || return 1; fi
    if [[ -d $pending/upload && ! -L $pending/upload ]]; then
        find -P "$pending/upload" -xdev -type d -exec chmod u+w -- {} + || return 1
    fi
    rm -rf --one-file-system -- "$pending"
}
clean_published_upload() {
    recover_pending || printf '%s\n' 'fpga-dispatch: pending upload cleanup failed' >&2
}

response() {
    jq -cn --arg id "$run_id" --arg disposition "$1" \
        '{schema_version:1,run_id:$id,disposition:$disposition}'
}
remove_cleaned_run() {
    remove_run_payload "$run/input" "$output" "$run/work" || return 1
    if exists "$control/started"; then
        safe_dir "$control/started" && rmdir -- "$control/started" || return 1
    fi
    rm -f -- "$control/registration.json" "$control/launch.json" "$control/activity.lock"
}

if [[ $operation != submit ]]; then
    if [[ $registered == false || $operation == cleanup ]]; then
        recover_pending || fail 1 'pending registration requires recovery'
    fi
    [[ $registered == true ]] || fail 2 'run_id is not registered'
    if ! exists "$cleaned"; then
        optional_file "$control/activity.lock" || fail 1 'unsafe activity lock'
        exec {activity_fd}>> "$control/activity.lock"
        lock_result=0
        flock -n -E 75 "$activity_fd" || lock_result=$?
        case "$lock_result" in
            0) ;;
            75) [[ $operation == status ]] || fail 2 'run is still active' ;;
            *) fail 1 'cannot acquire activity lock' ;;
        esac
        if [[ $operation == status ]]; then
            if [[ $lock_result == 0 ]]; then
                reconcile_run "$run" "$run_id" "$registered_mode" "$project/scripts/contract.jq" ||
                    fail 1 'cannot reconcile run status'
                if jq -e '.state == "finished"' "$output/status.json" >/dev/null; then
                    remove_run_payload "$run/work" || printf '%s\n' 'fpga-dispatch: work cleanup failed' >&2
                fi
            fi
            cat -- "$output/status.json"
            exit
        fi
        jq -e '.state == "finished"' "$output/status.json" >/dev/null || fail 2 'run is still active'
        if ! safe_file "$output/result.json" ||
            ! jq -e --arg kind result -f "$project/scripts/contract.jq" "$output/result.json" >/dev/null ||
            ! jq -e --arg id "$run_id" --arg mode "$registered_mode" --slurpfile result "$output/result.json" '
                ($result | length) == 1 and
                .run_id == $id and .mode == $mode and
                ($result[0] as $r | $r.run_id == $id and $r.mode == $mode and
                 $r.status == .result_status and $r.finished_at == .finished_at and $r.started_at == .started_at)
            ' "$output/status.json" >/dev/null; then
            fail 1 'result unavailable; call status before cleanup'
        fi
        for directory in "$run/input" "$output" "$run/work"; do
            optional_dir "$directory" || fail 1 'unsafe cleanup directory'
        done
        # Record the tombstone before deletion so cleanup can resume after a crash.
        # shellcheck disable=SC2016
        write_run_json "$cleaned" --arg id "$run_id" '{schema_version:1,run_id:$id,state:"cleaned"}' ||
            fail 1 'cannot publish cleanup marker'
    fi
    if [[ $operation == cleanup ]]; then
        remove_cleaned_run || fail 1 'cleanup incomplete; retry cleanup'
    fi
    cat -- "$cleaned"
    exit
fi
if [[ $registered == true ]]; then
    if exists "$cleaned"; then
        response existing
        exit
    fi
    [[ $mode == "$registered_mode" ]] || fail 2 'run_id is already registered with another mode'
    if exists "$upload"; then fail 2 'cannot replace input for a registered run_id'; fi
    clean_published_upload
    response existing
    exit
fi
recover_pending || fail 1 'pending registration requires recovery'

[[ -d $upload && ! -L $upload ]] || fail 2 'invalid_input: expected an upload directory'
incoming_mount=$(stat -c %m -- "$upload")
runs_mount=$(stat -c %m -- "$runs")
[[ $incoming_mount == "$runs_mount" ]] || fail 1 'incoming and runs must share a filesystem'
mkdir -- "$pending"
trap 'recover_pending || fail 1 "pending registration requires recovery"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

mv -T -- "$upload" "$pending/upload"
mkdir -p -- "$ready/work" "$ready/output/logs" "$ready/control"
preparation=0
bash "$project/scripts/prepare-job.sh" "$pending/upload" "$ready/work" "$run_id" "$mode" || preparation=$?
# Invalid HDL is a completed submission. Invalid packages remain unregistered.
case "$preparation" in
    0|3) ;;
    *) exit "$preparation" ;;
esac
cp -R -- "$pending/upload" "$ready/input"
chmod -R u+rX,a-w,go-rwx -- "$ready/input"
jq -cn --arg id "$run_id" --arg mode "$mode" \
    '{schema_version:1,run_id:$id,mode:$mode}' > "$ready/control/registration.json"
read -r boot_id < /proc/sys/kernel/random/boot_id
jq -cn --arg launch "$launch" --arg boot_id "$boot_id" \
    '{launch:$launch,boot_id:$boot_id}' > "$ready/control/launch.json"
publish_run_status "$ready/output" "$run_id" "$mode" '' starting dispatch
if [[ $preparation == 3 ]]; then
    publish_run_result "$ready/output" "$run_id" "$mode" '' invalid_input validating \
        hdl_invalid 'HDL violates the source rules or required student_top interface'
    rmdir -- "$ready/work"
fi

mv -T -- "$ready" "$run"
trap - EXIT
if [[ $launch == systemd && $preparation == 0 ]]; then
    # The dispatcher keeps the ID lock until launch succeeds or the failure is published.
    if ! (
        exec {lock_fd}>&-
        exec systemd-run --user --quiet --collect --no-ask-password --expand-environment=no \
            --unit="fpga-run-$run_id" --service-type=exec \
            --property=Restart=no --property=StandardInput=null --property=MemoryMax=3G \
            --property=StandardOutput=journal --property=StandardError=journal \
            --setenv="FPGA_JOBS_ROOT=$root" --setenv="FPGA_RUN_CONFIG=${FPGA_RUN_CONFIG:-}" \
            -- "$project/bin/fpga-run" --job "$run/input" --output "$run/output" --mode "$mode"
    ) >&2; then
        publish_run_result "$run/output" "$run_id" "$mode" '' internal_error dispatch \
            service_start_failed 'Cannot start the FPGA user service'
    fi
fi
clean_published_upload
response accepted
